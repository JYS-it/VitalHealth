# Copy this file to .env in the repository root for local development.
# The file is ignored by Git, so every teammate must create their own copy.
#
# A local PostgreSQL service must be running and listening on the host/port
# below. run_all.py initialises the VitalHealth schema and seeds the mock
# patients and demo clinician when this value is configured.
DATABASE_URL=postgresql+psycopg://vitalhealth:change-this-local-password@127.0.0.1:5432/vitalhealth

# All four web processes must use the same value. Generate a long random
# string for real deployments; this placeholder is suitable only for local
# coursework development.
SESSION_SECRET=change-this-local-session-secret

# Needed only when a teammate wants to self-register a clinician account.
# The pre-seeded Dr Alex demo clinician does not use this value.
CLINICIAN_ACCESS_CODE=
