# Copy this file to .env in the repository root for local development.
# The file is ignored by Git. Share its real values through your team's secret
# manager, never in Git, chat history, or screenshots.
#
# Recommended: paste the Supabase Session pooler URL from Dashboard > Connect.
# It begins with postgres:// or postgresql://; run_all.py accepts either form.
# Session pooler (port 5432) is suitable for this long-running web app on most
# Windows/macOS home networks. Add ?sslmode=require if it is not already there.
# run_all.py initialises the schema and seeds demo records on first launch.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# One small pool per local web process avoids consuming a large number of
# hosted-database connections. Leave these values unless you deploy at scale.
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
DATABASE_CONNECT_TIMEOUT=10

# All four web processes must use the same value. Generate a long random
# string for real deployments; this placeholder is suitable only for local
# coursework development.
SESSION_SECRET=change-this-local-session-secret

# Needed only when a teammate wants to self-register a clinician account.
# The pre-seeded Dr Alex demo clinician does not use this value.
CLINICIAN_ACCESS_CODE=
