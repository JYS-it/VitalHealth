# Copy this file to .env and fill in real values. .env is gitignored.

# Required for care-plan generation (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional — Flask session secret. Falls back to an insecure dev default if unset.
SECRET_KEY=

# Shared PostgreSQL database. Required for persistent records and audit events.
DATABASE_URL=postgresql+psycopg://vitalhealth:change-this-local-password@127.0.0.1:5432/vitalhealth
