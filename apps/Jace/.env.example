# Copy this file to .env and fill in real values. .env is gitignored.
#
# Note: Jace's own code reads GEMINI_API_KEY directly from the process
# environment (it does not call load_dotenv()). This file only takes effect
# when Jace is started via the repo-root run_all.py, which loads it and
# injects it into Jace's subprocess environment for you. If you run Jace
# standalone instead, export GEMINI_API_KEY in your shell before launching it.

# Required for GenAI explanations/note-extraction (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
