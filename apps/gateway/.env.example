# Copy this file to .env and fill in real values. .env is gitignored.

# Shared PostgreSQL database. Required — the gateway needs the `users` table
# to authenticate anyone. Unlike the three backend apps (where persistence
# is optional), without this set nobody can log in and every proxied route
# (/triage/*, /stroke/*, /emc/*) becomes permanently inaccessible.
DATABASE_URL=postgresql+psycopg://vitalhealth:change-this-local-password@127.0.0.1:5432/vitalhealth

# Signs and verifies the login session cookie. Falls back to an insecure
# dev default if unset — set a long random value in production; anyone who
# knows this value can forge a valid session cookie for any user.
#
# All four processes must agree on this value: the gateway signs the cookie
# and Jace/Jeslyn/YS verify it to decide which patient a record belongs to.
# run_all.py copies this value into the three backends automatically; if you
# start them by hand, export SESSION_SECRET yourself or their dashboards will
# never attribute a record to anyone.
SESSION_SECRET=

# Required to register a clinician account. Clinicians can see every patient's
# records, so registration fails closed: leave this blank and the Clinician
# option on /register is rejected outright.
CLINICIAN_ACCESS_CODE=

# Optional — set to "true" once the gateway is served over HTTPS in production.
SESSION_COOKIE_SECURE=

# Optional — powers the Vita assistant. run_all.py automatically reuses
# apps/Jace/.env's GEMINI_API_KEY when this is blank.
VITA_GEMINI_API_KEY=
VITA_GEMINI_MODEL=gemini-2.5-flash
