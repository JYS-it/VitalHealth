# Copy this file to .env and fill in real values. .env is gitignored.

# Required for EMC drafting/review (OpenRouter: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional — defaults to openai/gpt-4o-mini
OPENROUTER_MODEL=

# Shared PostgreSQL database. Required for persistent records and audit events.
DATABASE_URL=postgresql+psycopg://vitalhealth:change-this-local-password@127.0.0.1:5432/vitalhealth
