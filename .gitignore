__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/

# Secrets / local env — API keys are read from the environment, never committed
.env
*.key
*.pem
*.egg-info/

# Editor / IDE
.vs/

# Demo data build artifacts — regenerate with demo_data/compute_*.py
demo_data/output/

